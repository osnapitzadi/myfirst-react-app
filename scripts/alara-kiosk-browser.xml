<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>A.L.A.R.A Safety Board - open the board fullscreen in a kiosk browser at logon. Waits for the local server, then launches Chrome (or Edge).</Description>
    <Author>DESKTOP-8P7DPDL\Shipping</Author>
    <URI>\ALARA Kiosk Browser</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- A bit after the server task; the launcher itself also waits for the
         server port, so timing is forgiving. -->
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DESKTOP-8P7DPDL\Shipping</UserId>
      <Delay>PT25S</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DESKTOP-8P7DPDL\Shipping</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>6</Priority>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\Shipping\Desktop\myfirst-react-app-master\scripts\launch-kiosk-browser.cmd</Command>
    </Exec>
  </Actions>
</Task>
