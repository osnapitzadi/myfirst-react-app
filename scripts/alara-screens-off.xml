<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>A.L.A.R.A Safety Board - turn off all connected screens at 2:00 PM daily. The board server keeps running.</Description>
    <Author>DESKTOP-8P7DPDL\Shipping</Author>
    <URI>\ALARA Screens Off</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <!-- Re-blank every 15 min from 2 PM until 6 AM (16h). The display never
           times out on its own (never-sleep kiosk), so anything that wakes it at
           night - a wake timer, Windows Update, maintenance - would otherwise
           leave it on until the next 2 PM. Repeating keeps it dark. -->
      <Repetition>
        <Interval>PT15M</Interval>
        <Duration>PT16H</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-08-25T14:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DESKTOP-8P7DPDL\Shipping</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <!-- Don't "catch up" if the PC was off at 2 PM - that would blank the
         screen right after someone turned the machine on. -->
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <ExecutionTimeLimit>PT2M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "C:\Users\Shipping\Desktop\myfirst-react-app-master\scripts\screens-off.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
