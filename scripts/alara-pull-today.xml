<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>A.L.A.R.A Safety Board - daily data pull (Safecast radiation + IAEA isotope). Refreshes public/today.json each morning and catches up after the PC was off.</Description>
    <Author>DESKTOP-8P7DPDL\Shipping</Author>
    <URI>\ALARA Daily Pull</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- Every morning at 6:00 AM. If the PC was off, StartWhenAvailable (below)
         runs it as soon as the machine is back on. -->
    <CalendarTrigger>
      <StartBoundary>2026-08-24T06:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
    <!-- Also pull shortly after login, so a fresh boot gets current data. -->
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DESKTOP-8P7DPDL\Shipping</UserId>
      <Delay>PT1M</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DESKTOP-8P7DPDL\Shipping</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- Laptop: allow it to run on battery so a missed pull still catches up. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Priority>7</Priority>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <RestartOnFailure>
      <Interval>PT10M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\Shipping\Desktop\myfirst-react-app-master\scripts\pull-today.cmd</Command>
    </Exec>
  </Actions>
</Task>
